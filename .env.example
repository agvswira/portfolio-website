# Copy ke .env.local. Jangan commit nilai secret.

# OpenAI-compatible streaming chat
AI_API_KEY=
# Opsional; default https://api.openai.com/v1
AI_BASE_URL=
# Opsional; default gpt-4o-mini
AI_MODEL=

# Resend contact form
RESEND_API_KEY=
CONTACT_EMAIL=
# Contoh: Portfolio <hello@domain-terverifikasi.example>
CONTACT_FROM_EMAIL=

# Fail-closed sliding-window rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Gunakan nilai acak panjang dan nilai berbeda untuk Preview/Production.
RATE_LIMIT_SALT=
