{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*.astro", "src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "src/app",
    "src/components",
    "src/lib/blog.ts",
    "src/lib/data/skills.ts",
    "src/lib/gsap.ts",
    "src/lib/projects.ts",
    "src/lib/rate-limit.ts"
  ]
}
