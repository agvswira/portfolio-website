---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Halaman tidak ditemukan" noindex>
  <main
    id="main"
    class="content-page grid min-h-screen place-items-center px-5 py-24 text-center sm:px-6"
  >
    <div class="max-w-md border border-nord-border/40 bg-bg-surface p-8 sm:p-10">
      <p class="eyebrow section-eyebrow">404</p>
      <h1 class="mt-4 text-4xl font-semibold">Halaman tidak ditemukan</h1>
      <p class="mt-3 text-base leading-relaxed text-text-muted">
        Tautan ini mungkin sudah berubah atau tidak tersedia.
      </p>
      <a class="button-primary mt-7 inline-flex px-5 py-3" href="/">Kembali ke beranda</a>
    </div>
  </main>
</BaseLayout>
