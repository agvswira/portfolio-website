---
import { getBlogPosts, getProjects } from "@/lib/content";
import About from "@/sections/About.astro";
import BlogSection from "@/sections/BlogSection.astro";
import Contact from "@/sections/Contact.astro";
import Hero from "@/sections/Hero.astro";
import Projects from "@/sections/Projects.astro";
import Skills from "@/sections/Skills.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/ui/Footer.astro";
import ChatWidget from "@/ui/ChatWidget.astro";
import ScrollChapters from "@/ui/ScrollChapters.astro";

const [posts, projects] = await Promise.all([getBlogPosts(), getProjects()]);
---

<BaseLayout>
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 bg-bg-base">
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_120%_80%_at_50%_0%,transparent_60%,rgba(0,0,0,0.18)_100%)]"
    >
    </div>
  </div>
  <main id="main" class="relative z-[2]">
    <Hero />
    <ScrollChapters>
      <About {projects} />
      <Skills />
      <Projects {projects} />
      <BlogSection {posts} />
      <Contact />
    </ScrollChapters>
  </main>
  <Footer />
  <ChatWidget />
  <script>
    import { initHome } from "@/scripts/home";

    initHome();
  </script>
</BaseLayout>
