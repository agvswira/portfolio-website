---
import BaseLayout from "@/layouts/BaseLayout.astro";

export function getStaticPaths() {
  return ["botpass", "eling-bot", "portfolio-website"].map((slug) => ({
    params: { slug },
    props: { slug },
  }));
}

const { slug } = Astro.props;
---

<BaseLayout title="Project" noindex>
  <main id="main" class="mx-auto min-h-screen max-w-4xl px-6 py-24">
    <p class="eyebrow">Project migration</p>
    <h1 class="mt-4 text-4xl font-semibold">{slug}</h1>
  </main>
</BaseLayout>
