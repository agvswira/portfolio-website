---
import { render } from "astro:content";

import { getProjects, type ProjectEntry } from "@/lib/content";
import { PERSONAL, SITE } from "@/lib/constants";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/ui/Badge.astro";
import Footer from "@/ui/Footer.astro";

interface Props {
  project: ProjectEntry;
}

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const canonicalPath = `/projects/${project.data.slug}`;
const canonicalUrl = new URL(canonicalPath, SITE.url).href;
const projectImage = project.data.coverImage;
const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.summary,
  datePublished: project.data.publishedDate.toISOString(),
  dateModified: project.data.updatedDate.toISOString(),
  inLanguage: "id-ID",
  url: canonicalUrl,
  image: new URL(projectImage, SITE.url).href,
  keywords: project.data.tags,
  creator: { "@type": "Person", name: PERSONAL.fullName, url: SITE.url },
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  canonicalPath={canonicalPath}
  image={projectImage}
  imageAlt={`${project.data.title} — project ${PERSONAL.name}`}
  structuredData={projectJsonLd}
>
  <div class="content-page flex min-h-screen flex-col">
    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-5 pb-20 pt-28 sm:px-6">
      <a href="/#projects" class="content-back"
        ><span aria-hidden="true">←</span> Kembali ke project</a
      >
      <article>
        <header class="content-heading mt-10 max-w-4xl">
          <div class="mb-5 flex flex-wrap items-center gap-2">
            {project.data.featured && <Badge variant="featured">Featured</Badge>}
            {
              project.data.status === "discontinued" && (
                <Badge variant="discontinued">Discontinued</Badge>
              )
            }
            {project.data.tags.map((tag) => <Badge variant="tag">{tag}</Badge>)}
          </div>
          <h1
            class="text-balance text-4xl font-semibold leading-tight tracking-tight text-text-primary sm:text-5xl"
          >
            {project.data.title}
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-muted">
            {project.data.summary}
          </p>
          <dl class="mt-8 grid gap-5 py-6 sm:grid-cols-2">
            <div>
              <dt class="text-xs uppercase tracking-wider text-text-muted">Role</dt><dd
                class="mt-2 text-sm leading-relaxed text-text-primary"
              >
                {project.data.role}
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider text-text-muted">Timeline</dt><dd
                class="mt-2 text-sm leading-relaxed text-text-primary"
              >
                {project.data.timeline}
              </dd>
            </div>
          </dl>
          <div class="mt-6 flex flex-wrap gap-2">
            {
              project.data.demoUrl && (
                <a
                  href={project.data.demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="button-secondary px-3 py-2 text-sm"
                >
                  Live site ↗
                </a>
              )
            }
            <a
              href={project.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="button-secondary px-3 py-2 text-sm">Repository ↗</a
            >
            {
              project.data.evidence.map((item) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="button-secondary px-3 py-2 text-sm"
                >
                  {item.label} ↗
                </a>
              ))
            }
          </div>
          <div class="mt-8">
            <p class="mb-3 text-xs uppercase tracking-wider text-text-muted">Stack</p>
            <ul class="flex flex-wrap gap-2" aria-label="Technology stack">
              {
                project.data.stack.map((item) => (
                  <li>
                    <Badge variant="tag">{item}</Badge>
                  </li>
                ))
              }
            </ul>
          </div>
        </header>
        <figure class="case-cover mt-10 overflow-hidden border border-nord-border/40 bg-bg-surface">
          <img
            src={projectImage}
            alt={`Tampilan ${project.data.title}`}
            width="1200"
            height="630"
            loading="eager"
            decoding="async"
            class="block aspect-[40/21] h-auto w-full object-cover"
          />
        </figure>
        <div class="prose-dark mt-12"><Content /></div>
      </article>
    </main>
    <Footer />
  </div>
</BaseLayout>
