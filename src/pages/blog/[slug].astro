---
import { render } from "astro:content";

import { formatIndonesianDate, getBlogPosts, type BlogEntry } from "@/lib/content";
import { PERSONAL, SITE } from "@/lib/constants";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/ui/Badge.astro";
import Footer from "@/ui/Footer.astro";

interface Props {
  post: BlogEntry;
  older: BlogEntry | null;
  newer: BlogEntry | null;
}

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      older: posts[index + 1] ?? null,
      newer: posts[index - 1] ?? null,
    },
  }));
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const canonicalPath = `/blog/${post.slug}`;
const canonicalUrl = new URL(canonicalPath, SITE.url).href;
const blogJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.date).toISOString(),
  inLanguage: "id-ID",
  image: new URL(SITE.ogImage, SITE.url).href,
  mainEntityOfPage: canonicalUrl,
  author: { "@type": "Person", name: PERSONAL.fullName, url: SITE.url },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.date).toISOString()}
  structuredData={blogJsonLd}
>
  <div class="content-page flex min-h-screen flex-col">
    <main id="main" class="mx-auto w-full max-w-4xl flex-1 px-5 pb-20 pt-28 sm:px-6">
      <a href="/blog" class="content-back"><span aria-hidden="true">←</span> Semua tulisan</a>
      <article class="mt-10">
        <header class="mb-10 max-w-3xl">
          <div class="mb-5 flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => <Badge variant="tag">{tag}</Badge>)}
          </div>
          <h1
            class="mb-4 text-3xl font-semibold leading-tight tracking-tight text-text-primary sm:text-4xl"
          >
            {post.data.title}
          </h1>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 py-4 text-sm text-text-muted">
            <time datetime={post.data.date.toISOString()}
              >{formatIndonesianDate(post.data.date)}</time
            >
            <span aria-hidden="true" class="text-frost">/</span>
            <span>{post.readingTime} mnt baca</span>
          </div>
          <p class="mt-6 text-sm leading-relaxed text-text-secondary">
            {post.data.excerpt}
          </p>
        </header>
        <div class="prose-dark"><Content /></div>
      </article>
      {
        (older || newer) && (
          <nav aria-label="Navigasi artikel" class="mt-16 grid gap-4 sm:grid-cols-2">
            {older && (
              <a
                href={`/blog/${older.slug}`}
                class="group panel-surface flex w-fit max-w-[20rem] flex-col px-4 py-3 transition-colors hover:bg-bg-elevated/45"
              >
                <span class="mb-1 text-xs text-text-muted">← Lebih lama</span>
                <span class="block max-w-full truncate text-sm font-medium leading-snug text-text-secondary transition-colors group-hover:text-frost">
                  {older.data.title}
                </span>
              </a>
            )}
            {newer && (
              <a
                href={`/blog/${newer.slug}`}
                class="group panel-surface flex w-fit max-w-[20rem] flex-col px-4 py-3 transition-colors hover:bg-bg-elevated/45 sm:col-start-2 sm:justify-self-end sm:text-right"
              >
                <span class="mb-1 text-xs text-text-muted">Lebih baru →</span>
                <span class="block max-w-full truncate text-sm font-medium leading-snug text-text-secondary transition-colors group-hover:text-frost">
                  {newer.data.title}
                </span>
              </a>
            )}
          </nav>
        )
      }
    </main>
    <Footer />
  </div>
</BaseLayout>
