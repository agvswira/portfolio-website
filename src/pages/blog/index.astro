---
import { formatIndonesianDate, getBlogPosts } from "@/lib/content";
import { PERSONAL } from "@/lib/constants";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/ui/Badge.astro";
import Footer from "@/ui/Footer.astro";

const posts = await getBlogPosts();
---

<BaseLayout
  title="Blog"
  description={`Tulisan ${PERSONAL.name} tentang kuliah Informatika, tools, dan proses belajar.`}
>
  <div class="content-page flex min-h-screen flex-col">
    <main id="main" class="mx-auto w-full max-w-4xl flex-1 px-5 pb-20 pt-28 sm:px-6">
      <a href="/" class="content-back"><span aria-hidden="true">←</span> Beranda</a>
      <header class="content-heading mb-10 mt-10">
        <h1 class="mb-4 text-4xl font-semibold tracking-tight text-text-primary">Tulisan</h1>
        <p class="text-lg leading-relaxed text-text-muted">
          Catatan tentang kuliah, tools yang saya gunakan, dan proses belajar saya.
        </p>
      </header>
      <ol class="grid gap-4 sm:grid-cols-2" reversed>
        {
          posts.map((post) => (
            <li class="panel-surface border border-nord-border/45 transition-colors hover:border-frost/35">
              <a
                href={`/blog/${post.slug}`}
                class="group flex h-full flex-col gap-4 p-5 transition-colors hover:bg-bg-elevated/45 sm:p-6"
              >
                <div class="flex items-center justify-between gap-4">
                  <time
                    datetime={post.data.date.toISOString()}
                    class="w-36 flex-shrink-0 font-mono text-sm text-text-muted"
                  >
                    {formatIndonesianDate(post.data.date)}
                  </time>
                  <span class="text-xs text-text-muted">{post.readingTime} mnt baca</span>
                </div>
                <div class="flex-1">
                  <h2 class="mb-2 font-medium leading-snug text-text-primary transition-colors group-hover:text-frost">
                    {post.data.title}
                  </h2>
                  <p class="line-clamp-3 text-sm leading-relaxed text-text-muted">
                    {post.data.excerpt}
                  </p>
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {post.data.tags.map((tag) => (
                    <Badge variant="tag">{tag}</Badge>
                  ))}
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </main>
    <Footer />
  </div>
</BaseLayout>
