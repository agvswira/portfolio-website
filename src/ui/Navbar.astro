---
import { Icon } from "astro-icon/components";

import { NAV_ITEMS, SITE } from "@/lib/constants";
---

<header class="fixed inset-x-0 top-0 z-40 transition-all duration-300" data-navbar>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a
      href="#hero"
      class="text-lg font-semibold tracking-tight"
      aria-label={`${SITE.name} — ke atas`}
    >
      <span class="text-gradient">{SITE.name}</span><span class="text-frost">.</span>
    </a>
    <nav aria-label="Navigasi utama" class="hidden md:block">
      <ul class="flex items-center gap-1" role="list">
        {
          NAV_ITEMS.map((item, index) => (
            <li>
              <a
                href={item.href}
                aria-current={index === 0 ? "location" : undefined}
                class:list={[
                  "block rounded-lg px-4 py-2 text-sm transition-colors",
                  index === 0
                    ? "border border-nord-border/50 bg-bg-elevated text-text-primary"
                    : "text-text-muted hover:text-text-secondary",
                ]}
                data-nav-link
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      class="rounded-lg p-2 text-text-muted transition-colors hover:bg-bg-elevated hover:text-frost md:hidden"
      data-menu-toggle
    >
      <Icon name="lucide:menu" size={20} aria-hidden="true" data-menu-closed-icon />
      <Icon name="lucide:x" size={20} aria-hidden="true" class="hidden" data-menu-open-icon />
    </button>
  </div>
  <nav
    id="mobile-navigation"
    aria-label="Navigasi mobile"
    class="hidden border-b border-frost/10 bg-bg-surface/95 backdrop-blur-md md:hidden"
    data-mobile-nav
  >
    <ul class="mx-auto flex max-w-6xl flex-col gap-1 px-6 py-4" role="list">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-lg px-4 py-3 text-sm text-text-muted transition-colors hover:bg-bg-elevated/50 hover:text-text-secondary"
              data-nav-link
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
