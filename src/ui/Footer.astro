---
import { Icon } from "astro-icon/components";

import { SITE, SOCIAL_LINKS } from "@/lib/constants";

const icons: Record<string, string> = {
  FiGithub: "simple-icons:github",
  FiLinkedin: "simple-icons:linkedin",
  FiInstagram: "simple-icons:instagram",
  FaDiscord: "simple-icons:discord",
  FiMail: "lucide:mail",
};
---

<footer class="relative z-10 py-5">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 text-sm sm:flex-row sm:px-6"
  >
    <div class="text-center text-text-muted sm:text-left">
      <span class="font-semibold text-text-secondary">{SITE.name}</span>
      <span class="mx-2 text-frost/60">/</span>
      <span>© {new Date().getFullYear()}</span>
    </div>
    <nav aria-label="Social links">
      <ul class="flex items-center gap-1" role="list">
        {
          SOCIAL_LINKS.map(({ label, href, icon }) => (
            <li>
              <a
                href={href}
                aria-label={label}
                rel="noopener noreferrer"
                target={href.startsWith("mailto") ? undefined : "_blank"}
                class="footer-social-link inline-flex h-9 w-9 items-center justify-center text-text-muted transition-colors hover:text-frost"
              >
                <Icon name={icons[icon]} size={16} aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
