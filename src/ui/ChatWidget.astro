---
import { Icon } from "astro-icon/components";
---

<aside class="fixed bottom-5 right-5 z-50" data-chat-widget>
  <section
    id="chat-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="chat-title"
    class="mb-3 hidden h-[min(34rem,calc(100vh-7rem))] w-[min(23rem,calc(100vw-2rem))] flex-col overflow-hidden border border-nord-border/60 bg-bg-surface shadow-2xl"
    data-chat-panel
  >
    <header class="flex items-center justify-between px-4 py-3">
      <div>
        <h2 id="chat-title" class="text-sm font-semibold text-text-primary">Tanya tentang Wira</h2>
        <p class="text-xs text-text-muted">Tanya tentang project dan pengalaman</p>
      </div>
      <button
        type="button"
        aria-label="Tutup chat"
        class="inline-flex h-9 w-9 items-center justify-center text-text-muted transition-colors hover:bg-bg-elevated hover:text-frost"
        data-chat-close
      >
        <Icon name="lucide:x" size={18} aria-hidden="true" />
      </button>
    </header>
    <div
      class="flex-1 space-y-3 overflow-y-auto px-4 py-4 text-sm"
      role="log"
      aria-live="polite"
      aria-relevant="additions"
      data-chat-messages
    >
      <p class="mr-8 border border-nord-border/35 bg-bg-elevated px-3 py-2 text-text-secondary">
        Halo! Ada yang ingin kamu tanyakan tentang Wira, project, atau perjalanannya?
      </p>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-chat-status></p>
    <form class="flex gap-2 p-3" data-chat-form>
      <label for="chat-message" class="sr-only">Pesan untuk asisten</label>
      <input
        id="chat-message"
        name="message"
        type="text"
        required
        maxlength="2000"
        autocomplete="off"
        placeholder="Tulis pertanyaan..."
        class="form-control min-w-0 flex-1 px-3 py-2 text-sm"
        data-chat-input
      />
      <button
        type="submit"
        aria-label="Kirim pesan"
        class="inline-flex h-10 w-10 items-center justify-center bg-frost text-bg-base transition-colors hover:bg-frost-cyan disabled:cursor-not-allowed disabled:opacity-50"
        data-chat-submit
      >
        <Icon name="lucide:send" size={17} aria-hidden="true" />
      </button>
    </form>
  </section>
  <button
    type="button"
    aria-label="Buka chat"
    aria-expanded="false"
    aria-controls="chat-panel"
    class="ml-auto flex h-12 w-12 items-center justify-center bg-frost text-bg-base shadow-lg transition-transform hover:-translate-y-0.5 hover:bg-frost-cyan"
    data-chat-toggle
  >
    <Icon name="lucide:message-circle" size={22} aria-hidden="true" />
  </button>
</aside>
