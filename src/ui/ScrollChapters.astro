---
const chapters = [
  { number: "01", label: "About", href: "#about", image: "/images/chapters/about.webp" },
  { number: "02", label: "Skills", href: "#skills", image: "/images/chapters/skills.webp" },
  { number: "03", label: "Projects", href: "#projects", image: "/images/chapters/projects.webp" },
  { number: "04", label: "Blog", href: "#blog", image: "/images/chapters/blog.webp" },
  { number: "05", label: "Contact", href: "#contact", image: "/images/chapters/contact.webp" },
] as const;
---

<div
  class="relative mx-auto max-w-[84rem] lg:grid lg:grid-cols-[5rem_minmax(0,1fr)]"
  data-chapter-scroll
>
  <div class="relative hidden lg:block">
    <nav aria-label="Bab halaman" class="chapter-rail" data-chapter-rail>
      <div class="chapter-dial" data-chapter-dial>
        <div class="chapter-dial-symbols" aria-hidden="true">
          {
            chapters.map((chapter, index) => (
              <img
                src={chapter.image}
                alt=""
                width="512"
                height="512"
                decoding="async"
                class="chapter-dial-symbol"
                data-chapter-symbol
                data-chapter-art
                data-active={index === 0 ? "true" : "false"}
              />
            ))
          }
        </div>
        <ol class="chapter-dial-rotor" data-chapter-dial-rotor role="list">
          {
            chapters.map((chapter, index) => (
              <li class="chapter-dial-step" data-step-index={index}>
                <a
                  href={chapter.href}
                  aria-label={`${chapter.number} ${chapter.label}`}
                  aria-current={index === 0 ? "step" : undefined}
                  class="chapter-dial-link"
                  data-chapter-link
                >
                  <span class="chapter-dial-marker" data-chapter-label>
                    <span class="chapter-dial-number" aria-hidden="true">
                      {chapter.number}
                    </span>
                  </span>
                  <span class="sr-only">{chapter.label}</span>
                </a>
                <span class="chapter-dial-halo" aria-hidden="true">
                  <span class="chapter-dial-dot" data-chapter-dot />
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </nav>
  </div>

  <div class="min-w-0" data-chapter-content>
    <slot />
  </div>
</div>
