---
interface Props {
  id: string;
  title: string;
  subtitle: string;
  class?: string;
}

const { id, title, subtitle, class: className = "" } = Astro.props;
---

<section id={id} class:list={["site-section relative z-10 scroll-mt-20 py-20 sm:py-24", className]}>
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <header class="section-heading mb-10 sm:mb-12" data-reveal>
      <h2 class="mb-3 text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">
        {title}
      </h2>
      <p class="max-w-2xl text-lg leading-relaxed text-text-muted">{subtitle}</p>
    </header>
    <slot />
  </div>
</section>
