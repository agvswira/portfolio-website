---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  subtitle: string;
  class?: string;
}

const { id, eyebrow, title, subtitle, class: className = "" } = Astro.props;
---

<section id={id} class:list={["relative z-10 scroll-mt-16 py-24", className]}>
  <div class="mx-auto max-w-6xl px-6">
    <header class="mb-12 text-center" data-reveal>
      <p class="eyebrow mb-3">{eyebrow}</p>
      <h2 class="mb-4 text-3xl font-semibold tracking-tight text-text-primary sm:text-4xl">
        {title}
      </h2>
      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-text-muted">{subtitle}</p>
    </header>
    <slot />
  </div>
</section>
