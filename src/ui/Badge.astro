---
interface Props {
  variant?: "frost" | "featured" | "discontinued" | "tag" | "available";
  class?: string;
}

const { variant = "frost", class: className = "" } = Astro.props;
const variants = {
  frost: "bg-frost/10 text-frost border border-frost/20",
  featured: "bg-aurora-yellow/10 text-aurora-yellow border border-aurora-yellow/20",
  discontinued: "bg-aurora-red/10 text-[#E099A0] border border-aurora-red/25",
  tag: "bg-bg-elevated/70 text-text-secondary border border-nord-border/50 transition-colors hover:border-frost/30",
  available: "bg-frost/10 text-frost border border-frost/20",
};
---

<span
  class:list={[
    "inline-flex min-h-6 items-center px-2 py-0.5 text-xs font-medium",
    variant === "available" && "gap-1.5 px-2.5 py-1",
    variants[variant],
    className,
  ]}
>
  {variant === "available" && <span class="h-1.5 w-1.5 rounded-full bg-frost" aria-hidden="true" />}
  <slot />
</span>
