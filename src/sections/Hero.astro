---
import { Icon } from "astro-icon/components";

import { PERSONAL, SITE, SOCIAL_LINKS } from "@/lib/constants";

const socialIcons: Record<string, string> = {
  FiGithub: "simple-icons:github",
  FiLinkedin: "simple-icons:linkedin",
  FiInstagram: "simple-icons:instagram",
  FaDiscord: "simple-icons:discord",
  FiMail: "lucide:mail",
};
---

<section id="hero" class="relative h-screen w-full overflow-hidden" aria-label="Hero">
  <div aria-hidden="true" class="absolute inset-0" data-hero-sky></div>

  <div
    aria-hidden="true"
    class="parallax-layer pointer-events-none absolute inset-x-0 bottom-0 z-[2]"
    data-mountain="far"
  >
    <svg viewBox="0 0 1440 480" preserveAspectRatio="none" class="block w-full">
      <path
        d="M0,480 L0,216 C90,190 150,100 240,112 C330,124 354,202 442,218 C530,234 604,296 720,302 C830,308 868,238 958,214 C1048,190 1086,110 1178,124 C1270,138 1326,196 1440,172 L1440,480 Z"
        fill="#3B4252"></path>
    </svg>
  </div>
  <div
    aria-hidden="true"
    class="parallax-layer pointer-events-none absolute inset-x-0 bottom-0 z-[3]"
    data-mountain="mid"
  >
    <svg viewBox="0 0 1440 480" preserveAspectRatio="none" class="block w-full">
      <path
        d="M0,480 L0,190 C110,220 172,260 280,230 C390,198 432,110 540,132 C650,154 704,232 818,218 C932,204 1000,130 1110,150 C1220,170 1330,252 1440,208 L1440,480 Z"
        fill="#434C5E"></path>
    </svg>
  </div>
  <div
    aria-hidden="true"
    class="parallax-layer pointer-events-none absolute inset-x-0 bottom-0 z-[4]"
    data-mountain="near"
  >
    <svg viewBox="0 0 1440 480" preserveAspectRatio="none" class="block w-full">
      <path
        d="M0,480 L0,210 C110,160 170,142 260,178 C350,214 400,270 510,250 C620,230 690,152 800,172 C910,192 978,250 1090,224 C1202,198 1300,124 1440,164 L1440,480 Z"
        fill="#4C566A"></path>
    </svg>
  </div>
  <div aria-hidden="true" class="scene-seam"></div>

  <div class="absolute inset-0 z-[1] flex flex-col items-center justify-center" data-hero-content>
    <div class="mx-auto flex w-full max-w-4xl flex-col items-center gap-5 px-6 text-center">
      <h1 class="text-5xl font-semibold leading-[1.1] tracking-tight sm:text-6xl lg:text-7xl">
        <span class="text-gradient">{SITE.name}</span>
      </h1>
      <p class="max-w-xl text-xl font-medium text-text-secondary sm:text-2xl">{PERSONAL.role}</p>
      <p class="max-w-2xl text-base leading-relaxed text-text-muted sm:text-lg">{PERSONAL.bio}</p>
      <div class="mt-2 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#projects"
          class="shimmer-btn inline-flex items-center justify-center rounded-none bg-frost px-5 py-2.5 text-sm font-semibold text-bg-base transition-all duration-200 hover:-translate-y-0.5 hover:bg-frost-cyan hover:shadow-[0_6px_24px_rgba(136,192,208,0.35)]"
          >View Projects</a
        >
        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-none border border-frost/40 px-5 py-2.5 text-sm font-medium text-frost transition-all duration-200 hover:border-frost hover:bg-frost/10"
          >Get in Touch</a
        >
      </div>
      <div class="mt-1 flex items-center gap-4">
        {
          SOCIAL_LINKS.filter(({ label }) => label !== "Email").map(({ label, href, icon }) => (
            <a
              href={href}
              aria-label={label}
              rel="noopener noreferrer"
              target="_blank"
              class="p-1 text-text-muted transition-colors hover:text-frost"
            >
              <Icon name={socialIcons[icon]} size={20} aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div
    aria-hidden="true"
    class="absolute bottom-4 left-1/2 z-[6] -translate-x-1/2 text-text-muted"
    data-hero-cue
  >
    <Icon name="lucide:chevron-down" size={22} />
  </div>
</section>
