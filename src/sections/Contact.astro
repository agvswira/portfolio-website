---
import { Icon } from "astro-icon/components";

import { PERSONAL, SOCIAL_LINKS } from "@/lib/constants";
import Section from "@/ui/Section.astro";

const icons: Record<string, string> = {
  FiGithub: "simple-icons:github",
  FiLinkedin: "simple-icons:linkedin",
  FiInstagram: "simple-icons:instagram",
  FaDiscord: "simple-icons:discord",
  FiMail: "lucide:mail",
};
---

<Section
  id="contact"
  title="Mari terhubung"
  subtitle="Punya ide project, ingin berdiskusi, atau sekadar menyapa? Saya senang mendengarnya."
>
  <div class="grid items-start gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
    <div class="portfolio-panel p-5 sm:p-7" data-reveal>
      <form action="/api/contact" method="post" data-contact-form>
        <input
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="pointer-events-none absolute h-0 w-0 opacity-0"
        />
        <div class="flex flex-col gap-5">
          <div>
            <label for="contact-name" class="mb-2 block text-sm text-text-secondary">Nama</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              minlength="2"
              maxlength="100"
              required
              placeholder="Nama lengkap Anda"
              class="form-control"
            />
          </div>
          <div>
            <label for="contact-email" class="mb-2 block text-sm text-text-secondary">Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              required
              placeholder="email@anda.com"
              class="form-control"
            />
          </div>
          <div>
            <label for="contact-message" class="mb-2 block text-sm text-text-secondary">Pesan</label
            >
            <textarea
              id="contact-message"
              name="message"
              required
              minlength="10"
              maxlength="3000"
              rows="6"
              placeholder="Ceritakan project atau pertanyaan Anda..."
              class="form-control min-h-40 resize-y"></textarea>
          </div>
          <button
            type="submit"
            class="button-primary min-h-12 w-full px-5 text-sm font-semibold"
            data-contact-submit
          >
            Kirim pesan
          </button>
        </div>
      </form>
      <div role="status" aria-live="polite" aria-atomic="true" class="mt-4" data-contact-status>
        <p
          id="contact-success"
          class="hidden border border-aurora-green/25 bg-aurora-green/10 px-4 py-3 text-sm text-aurora-green target:block"
        >
          Pesan berhasil terkirim! Saya akan segera menghubungi Anda.
        </p>
        <p
          id="contact-error"
          class="hidden border border-aurora-red/25 bg-aurora-red/10 px-4 py-3 text-sm text-[#E099A0] target:block"
        >
          Pesan belum berhasil dikirim. Silakan periksa kembali atau coba nanti.
        </p>
      </div>
    </div>

    <aside class="lg:pt-1" data-reveal>
      <h3 class="font-semibold text-text-primary">Terhubung langsung</h3>
      <p class="mt-2 max-w-md text-sm leading-relaxed text-text-muted">
        Untuk respons cepat, kirim email atau temukan saya di platform berikut.
      </p>
      <a
        href={`mailto:${PERSONAL.email}`}
        class="contact-email mt-6 flex items-center justify-between gap-4 border border-frost/30 bg-frost/5 px-4 py-4 text-sm transition-colors hover:border-frost/60 hover:bg-frost/10"
      >
        <span>
          <span class="block text-xs text-text-muted">Email</span>
          <span class="mt-1 block break-all font-medium text-text-primary">{PERSONAL.email}</span>
        </span>
        <Icon name="lucide:mail" size={18} class="shrink-0 text-frost" aria-hidden="true" />
      </a>
      <ul class="mt-3 grid grid-cols-2 gap-2" role="list">
        {
          SOCIAL_LINKS.filter(({ label }) => label !== "Email").map(({ label, href, icon }) => (
            <li>
              <a
                href={href}
                rel="noopener noreferrer"
                target="_blank"
                class="social-card flex min-h-12 items-center gap-3 border border-nord-border/40 bg-bg-surface px-3 py-3 text-sm font-medium text-text-secondary transition-colors hover:border-frost/35 hover:text-frost"
              >
                <Icon name={icons[icon]} size={16} aria-hidden="true" />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</Section>
