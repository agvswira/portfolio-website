---
import { Icon } from "astro-icon/components";

import type { ProjectEntry } from "@/lib/content";
import Badge from "@/ui/Badge.astro";
import Section from "@/ui/Section.astro";

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
const tags = Array.from(new Set(projects.flatMap((project) => project.data.tags))).sort((a, b) =>
  a.localeCompare(b, "id")
);
---

<Section
  id="projects"
  eyebrow="Proyek"
  title="Karya Pilihan"
  subtitle="Proyek belajar yang aku bangun sambil mengeksplorasi teknologi baru."
>
  <div
    class="mb-10 flex flex-wrap justify-center gap-2"
    aria-label="Filter proyek"
    data-project-filters
  >
    {
      ["All", ...tags].map((tag, index) => (
        <button
          type="button"
          aria-pressed={index === 0 ? "true" : "false"}
          data-project-filter={tag}
          class:list={[
            "rounded-full border px-4 py-1.5 text-sm font-medium transition-all duration-200",
            index === 0
              ? "border-frost/40 bg-frost/15 text-frost"
              : "border-nord-border/40 bg-transparent text-text-muted hover:border-frost/20 hover:text-text-secondary",
          ]}
        >
          {tag}
        </button>
      ))
    }
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-project-grid>
    {
      projects.map((project) => (
        <article
          class:list={[
            "project-card hud-card spotlight-card flex flex-col gap-4 p-5",
            project.data.featured && "border-beam",
          ]}
          data-project-card
          data-project-tags={JSON.stringify(project.data.tags)}
          data-reveal
          data-spotlight
        >
          <div class="flex flex-1 flex-col gap-2">
            <div class="flex items-start justify-between gap-2">
              <h3 class="text-sm font-semibold leading-snug text-text-primary">
                {project.data.title}
              </h3>
              {project.data.featured && <Badge variant="featured">Featured</Badge>}
            </div>
            <div class="flex-1">
              <p class="mb-2 text-[10px] uppercase tracking-wider text-text-muted">Outcome</p>
              <ul class="space-y-2 text-xs leading-relaxed text-text-muted">
                {project.data.outcome.map((item) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-frost">
                      →
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-1 flex flex-wrap gap-1.5">
              {project.data.tags.map((tag) => (
                <Badge variant="tag">{tag}</Badge>
              ))}
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-3 border-t border-nord-border/20 pt-3">
            <a
              href={`/projects/${project.data.slug}`}
              class="text-xs font-medium text-frost transition-colors hover:text-frost-cyan"
            >
              Case study →
            </a>
            <a
              href={project.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`GitHub — ${project.data.title}`}
              class="flex items-center gap-1.5 text-xs text-text-muted transition-colors hover:text-frost"
            >
              <Icon name="simple-icons:github" size={13} aria-hidden="true" />
              GitHub
            </a>
            {project.data.demoUrl && (
              <a
                href={project.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Live Demo — ${project.data.title}`}
                class="flex items-center gap-1.5 text-xs text-text-muted transition-colors hover:text-frost"
              >
                <Icon name="lucide:external-link" size={13} aria-hidden="true" />
                Live Demo
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
  <p class="hidden py-12 text-center text-text-muted" data-project-empty>
    Tidak ada proyek dengan tag tersebut.
  </p>
</Section>
