---
import { Icon } from "astro-icon/components";

import { SKILL_GROUPS } from "@/lib/skills";
import Section from "@/ui/Section.astro";
---

<Section
  id="skills"
  title="Tech Stack yang Saya Gunakan"
  subtitle="Tools dan teknologi yang pernah saya gunakan saat belajar dan mengerjakan project."
>
  <div
    class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
  >
    {
      SKILL_GROUPS.map((group) => (
        <article class="skill-group panel-surface p-5 sm:p-6" data-reveal>
          <h3 class="mb-4 text-sm font-semibold tracking-tight text-text-primary">
            {group.category}
          </h3>
          <ul class="flex flex-wrap gap-2" role="list">
            {group.items.map(({ name, icon }) => (
              <li class="skill-chip" title={name}>
                <Icon name={icon} size={17} class="shrink-0 text-frost-blue" aria-hidden="true" />
                <span class="text-center leading-tight">{name}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
