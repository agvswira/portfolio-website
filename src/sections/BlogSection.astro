---
import type { BlogEntry } from "@/lib/content";
import { formatIndonesianDate } from "@/lib/content";
import Badge from "@/ui/Badge.astro";
import Section from "@/ui/Section.astro";

interface Props {
  posts: BlogEntry[];
}

const { posts } = Astro.props;
---

<Section
  id="blog"
  eyebrow="Blog"
  title="Catatan dan Tulisan"
  subtitle="Catatan tentang kuliah, tools yang saya gunakan, dan proses belajar saya."
>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      posts.slice(0, 3).map((post) => (
        <a href={`/blog/${post.slug}`} class="group block" data-reveal>
          <article
            class="blog-card hud-card spotlight-card flex h-full flex-col gap-3 p-5"
            data-spotlight
          >
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 3).map((tag) => (
                <Badge variant="tag">{tag}</Badge>
              ))}
            </div>
            <h3 class="flex-1 text-sm font-semibold leading-snug text-text-primary transition-colors group-hover:text-frost">
              {post.data.title}
            </h3>
            <p class="line-clamp-3 text-xs leading-relaxed text-text-muted">{post.data.excerpt}</p>
            <div class="mt-auto flex items-center justify-between border-t border-nord-border/20 pt-2 text-[10px] text-text-muted">
              <time datetime={post.data.date.toISOString()}>
                {formatIndonesianDate(post.data.date)}
              </time>
              <span>{post.readingTime} mnt baca</span>
            </div>
          </article>
        </a>
      ))
    }
  </div>
  <div class="mt-10 text-center">
    <a
      href="/blog"
      class="inline-flex items-center gap-2 rounded-lg border border-frost/30 px-5 py-2.5 text-sm text-frost transition-colors hover:border-frost/60 hover:text-frost-cyan"
    >
      Lihat Semua Artikel →
    </a>
  </div>
</Section>
