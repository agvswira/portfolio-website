---
import type { BlogEntry } from "@/lib/content";
import { formatIndonesianDate } from "@/lib/content";
import Badge from "@/ui/Badge.astro";
import Section from "@/ui/Section.astro";

interface Props {
  posts: BlogEntry[];
}

const { posts } = Astro.props;
---

<Section
  id="blog"
  title="Catatan dan Tulisan"
  subtitle="Catatan tentang kuliah, tools yang saya gunakan, dan proses belajar saya."
>
  <div class="grid gap-4 md:grid-cols-2">
    {
      posts.slice(0, 4).map((post) => (
        <a href={`/blog/${post.slug}`} class="group block" data-reveal>
          <article class="blog-card flex h-full flex-col gap-4 border border-nord-border/45 bg-bg-surface p-5 transition-colors hover:border-frost/35 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <time datetime={post.data.date.toISOString()} class="text-[10px] text-text-muted">
                {formatIndonesianDate(post.data.date)}
              </time>
              <span class="text-[10px] text-text-muted">{post.readingTime} mnt baca</span>
            </div>
            <h3 class="flex-1 text-sm font-semibold leading-snug text-text-primary transition-colors group-hover:text-frost">
              {post.data.title}
            </h3>
            <p class="line-clamp-3 text-xs leading-relaxed text-text-muted">{post.data.excerpt}</p>
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.slice(0, 3).map((tag) => (
                <Badge variant="tag">{tag}</Badge>
              ))}
            </div>
          </article>
        </a>
      ))
    }
  </div>
  <div class="mt-8">
    <a href="/blog" class="button-secondary inline-flex items-center gap-2 px-4 py-2.5 text-sm">
      Lihat semua tulisan <span aria-hidden="true">→</span>
    </a>
  </div>
</Section>
