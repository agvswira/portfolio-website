---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import profileImage from "@/assets/profile.jpg";
import { PERSONAL, TIMELINE } from "@/lib/constants";
import type { BlogEntry, ProjectEntry } from "@/lib/content";
import { SKILL_GROUPS } from "@/lib/skills";
import Section from "@/ui/Section.astro";

interface Props {
  posts: BlogEntry[];
  projects: ProjectEntry[];
}

const { posts, projects } = Astro.props;
const skillCount = SKILL_GROUPS.reduce((total, group) => total + group.items.length, 0);
const stats = [
  { label: "Tahun Belajar", value: "1+" },
  { label: "Project", value: String(projects.length) },
  { label: "Artikel", value: String(posts.length) },
  { label: "Tech & Skill", value: `${skillCount}+` },
];
---

<Section
  id="about"
  eyebrow="Tentang Saya"
  title={`Halo, saya ${PERSONAL.name}`}
  subtitle="Di sini saya membagikan project dan catatan dari proses belajar selama kuliah Informatika."
>
  <div class="mt-8 grid items-start gap-12 lg:grid-cols-2">
    <article class="hud-card spotlight-card p-8" data-reveal data-spotlight>
      <div
        class="mb-6 h-20 w-20 overflow-hidden rounded-2xl border border-nord-border/50 bg-bg-elevated"
      >
        <Image
          src={profileImage}
          alt={PERSONAL.fullName}
          width="80"
          height="80"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <h3 class="mb-1 text-xl font-semibold text-text-primary">{PERSONAL.fullName}</h3>
      <p class="mb-4 text-sm font-medium text-frost">{PERSONAL.role}</p>
      <p class="mb-5 flex items-center gap-1.5 text-sm text-text-muted">
        <Icon name="lucide:map-pin" size={14} aria-hidden="true" />{PERSONAL.location}
      </p>
      <p class="mb-6 text-sm leading-relaxed text-text-muted">{PERSONAL.bio}</p>
      <dl class="grid grid-cols-2 gap-3">
        {
          stats.map((stat) => (
            <div class="rounded-lg border border-nord-border/30 bg-bg-elevated/60 p-3">
              <dd class="text-xl font-bold text-text-primary">{stat.value}</dd>
              <dt class="mt-0.5 text-xs text-text-muted">{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </article>

    <div data-reveal>
      <h3 class="mb-6 text-lg font-semibold text-text-primary">Perjalanan</h3>
      <div class="relative">
        <div class="absolute bottom-3 left-[11px] top-3 w-px bg-nord-border/40" aria-hidden="true">
        </div>
        {
          TIMELINE.map((item) => (
            <article class="relative flex gap-5 pb-8 last:pb-0">
              <div class="relative mt-1 flex-shrink-0">
                <div class="relative z-10 flex h-6 w-6 items-center justify-center rounded-full border-2 border-frost-deep bg-bg-elevated">
                  <div class="h-2 w-2 rounded-full bg-frost" />
                </div>
              </div>
              <div>
                <p class="eyebrow mb-1 text-[10px]">{item.year}</p>
                <p class="text-sm font-semibold leading-snug text-frost">{item.place}</p>
                <h4 class="mt-0.5 font-medium leading-snug text-text-primary">{item.title}</h4>
                {item.desc && (
                  <p class="mt-1 text-sm leading-relaxed text-text-muted">{item.desc}</p>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</Section>
