---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import profileImage from "@/assets/profile.jpg";
import { PERSONAL, TIMELINE } from "@/lib/constants";
import type { ProjectEntry } from "@/lib/content";
import { SKILL_GROUPS } from "@/lib/skills";
import Section from "@/ui/Section.astro";

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
const stats = [
  { label: "Tahun Belajar", value: "1+" },
  { label: "Project", value: String(projects.length) },
];
---

<Section
  id="about"
  title={`Halo, saya ${PERSONAL.name}`}
  subtitle="Di sini saya membagikan project dan catatan dari proses belajar selama kuliah Informatika."
>
  <div class="grid items-start gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <article class="portfolio-panel p-6 sm:p-8" data-reveal>
      <div class="mb-6 flex items-center gap-4 sm:gap-5">
        <div class="h-16 w-16 shrink-0 overflow-hidden border border-nord-border/50 bg-bg-elevated sm:h-20 sm:w-20">
          <Image
            src={profileImage}
            alt={PERSONAL.fullName}
            width="80"
            height="80"
            format="webp"
            quality={80}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="min-w-0">
          <p class="mb-1 text-sm font-medium text-frost">{PERSONAL.role}</p>
          <h3 class="text-lg font-semibold leading-tight text-text-primary sm:text-xl">
            {PERSONAL.fullName}
          </h3>
          <p class="mt-2 flex items-center gap-1.5 text-xs text-text-muted sm:text-sm">
            <Icon name="lucide:map-pin" size={14} aria-hidden="true" />{PERSONAL.location}
          </p>
        </div>
      </div>
      <p class="mb-6 text-sm leading-7 text-text-muted">
        {PERSONAL.bio}
      </p>
      <dl class="grid grid-cols-2 gap-x-6 pt-5">
        {
          stats.map((stat) => (
            <div class="flex min-w-0 flex-col gap-1 py-1">
              <dd class="text-2xl font-semibold text-text-primary">{stat.value}</dd>
              <dt class="mt-1.5 text-xs text-text-muted">{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </article>

    <div class="pt-1" data-reveal>
      <div class="mb-7">
        <h3 class="text-lg font-semibold text-text-primary">Perjalanan</h3>
      </div>
      <div class="timeline-list">
        {
          TIMELINE.map((item) => (
            <article class="timeline-entry">
              <p class="mb-1 font-sans text-sm font-medium text-frost">{item.year}</p>
              <div>
                <h4 class="font-medium leading-snug text-text-primary">{item.title}</h4>
                <p class="text-sm font-semibold leading-snug text-frost">{item.place}</p>
                {item.desc && (
                  <p class="mt-2 text-sm leading-relaxed text-text-muted">{item.desc}</p>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</Section>
