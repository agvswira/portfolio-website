---
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/sora";
import "../styles/globals.css";

import profileImage from "@/assets/profile.jpg";
import { PERSONAL, SITE } from "@/lib/constants";
import Navbar from "@/ui/Navbar.astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  image = SITE.ogImage,
  imageAlt = `${PERSONAL.name} — ${PERSONAL.role}`,
  ogType = "website",
  publishedTime,
  modifiedTime,
  structuredData,
} = Astro.props;
const canonical = new URL(canonicalPath, SITE.url);
const socialImage = new URL(image, SITE.url);
const pageTitle = title === SITE.title ? title : `${title} | ${PERSONAL.name}`;
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: PERSONAL.fullName,
  alternateName: PERSONAL.name,
  url: SITE.url,
  image: new URL(profileImage.src, SITE.url).href,
  jobTitle: PERSONAL.role,
  homeLocation: { "@type": "Place", name: PERSONAL.location },
  description: SITE.description,
  sameAs: [PERSONAL.github, PERSONAL.linkedin, PERSONAL.instagram],
};
const pageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const jsonLd = JSON.stringify([personJsonLd, ...pageStructuredData]).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#242933" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body>
    <a href="#main" class="skip-link">Lewati ke konten</a>
    <Navbar />
    <slot />
  </body>
</html>
